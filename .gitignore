# Rust build output
/target/

# Local runtime state: databases, JSONL traces, demo artifacts
/.local/

# Research data: keep policies/manifests in git, payloads local by default
/data/raw/
/data/vendor/
/data/private/
/data/cache/

# Large/generated research artifacts should be archived deliberately
/artifacts/
/papers/**/build/

# Editor / OS noise
.DS_Store

# MIOBA experiment runtime
/experiments/mioba/.runs/

# R0 experiment runtime
/experiments/r0/artifacts/
__pycache__/
*.pyc
/.venv*/
.pytest_cache/

# H0 experiment runtime
/experiments/h0/runs/
/experiments/h0/results/

# T0 experiment runtime artifacts (checkpoints, eval outputs, run state)
/experiments/t0/artifacts/

# U0 experiment runtime artifacts (checkpoints, eval outputs, run state)
/experiments/u0/artifacts/
/experiments/u0/logs/
/experiments/u0/reports/figs/
/graphify-out

# Anatomical dataset stores (derived from upstream releases; regenerable
# by experiments/mioba/importers/*) — code and manifests stay in git
/experiments/mioba/datasets/*/store*/
# Physiology overlays (regenerable by physio/overlay.py)
/experiments/mioba/datasets/*/physiology/
/logs/

# Site-specific resident configuration (hosts, NAS, private repos): local only
/deploy/resident/local/
