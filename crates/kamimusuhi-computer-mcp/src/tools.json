    "inputSchema": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string"
        },
        "window": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false
    }
  },
  {
    "name": "open_application",
    "description": "アプリを開く。macOS: アプリ名または /path/App.app。Linux: 管理ディスプレイ上でコマンド名（+args 配列）として起動。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
