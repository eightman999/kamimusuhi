# Tokens are placeholders. Store the real file outside Git with mode 600.
SLACK_APP_TOKEN=xapp-REPLACE
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_TEAM_ID=T_REPLACE
# Comma-separated IDs; all three workspace/user/channel checks must pass.
SLACK_ALLOWED_USER_IDS=U_REPLACE
SLACK_ALLOWED_CHANNEL_IDS=C_REPLACE
# Optional: share the desktop operator's conversation subject (one allowed user only).
SLACK_OPERATOR_SUBJECT=eightman
