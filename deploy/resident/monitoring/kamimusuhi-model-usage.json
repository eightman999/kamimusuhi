        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "料金の推移 / 時間（実額・推定別）",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cost_kind) (rate(kamimusuhi_usage_cost_usd_total{job=\"kamimusuhi-resident\",node=~\"$node\",tier=~\"$tier\",model=~\"$model\",kind=\"$kind\"}[$__rate_interval])) * 3600 and (sum by (cost_kind) (increase(kamimusuhi_usage_cost_reports_total{job=\"kamimusuhi-resident\",node=~\"$node\",tier=~\"$tier\",model=~\"$model\",kind=\"$kind\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{cost_kind}}",
          "datasource": {
            "type": "prometheus",
