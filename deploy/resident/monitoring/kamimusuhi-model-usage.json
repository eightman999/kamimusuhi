    {
      "id": 14,
      "title": "使用モデルと最終呼び出し時刻",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "選択期間の終端時点で観測した最終呼び出し。個別要求の全件一覧ではありません。",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (node, tier, model, outcome) (kamimusuhi_usage_last_request_timestamp_seconds{job=\"kamimusuhi-resident\",node=~\"$node\",tier=~\"$tier\",model=~\"$model\",kind=\"$kind\"}) * 1000",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "未収集",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "最終呼び出し"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "最終呼び出し",
            "desc": true
          }
