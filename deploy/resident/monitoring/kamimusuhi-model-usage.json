          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "入出力・キャッシュのトークン / 分",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "cached は prompt の内数で、合計に加算しません。報告がない値は不明件数を参照。",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (token_type) (rate(kamimusuhi_usage_tokens_total{job=\"kamimusuhi-resident\",node=~\"$node\",tier=~\"$tier\",model=~\"$model\",kind=\"$kind\"}[$__rate_interval])) * 60",
          "legendFormat": "{{token_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true,
          "instant": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
