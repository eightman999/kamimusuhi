      "model": "gpt-5-mini",
      "auth_env": "OPENAI_API_KEY",
      "timeout_secs": 60,
      "probe_interval_secs": 300,
      "input_usd_per_mtok": 0.25,
      "output_usd_per_mtok": 2.0,
      "privacy_ok_for_private_memory": true,
      "reasoning_suppression": true,
      "context_limit_tokens": 400000,
      "extra_body": {
