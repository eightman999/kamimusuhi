{
  "node": {
    "id": "pi",
    "role": "continuity",
    "listen": "0.0.0.0:7860"
  },
  "paths": {
    "root": "/srv/kamimusuhi",
    "spool_warn_bytes": 8589934592
  },
  "nas": {
    "root": "/mnt/kamimusuhi",
    "probe_timeout_secs": 8
  },
  "peers": [
    {
      "id": "llm_master",
      "role": "cognition",
      "url": "http://LLM_MASTER_HOST:7860"
    }
  ],
  "tiers": [
    {
      "name": "hai",
      "billing": "subscription",
      "base_url": "https://hai-api.hcloud.ltd/v1",
      "model": "qwen3.8-27b-uncensored",
      "auth_env": "HAI_API_KEY",
      "timeout_secs": 30,
      "probe_interval_secs": 60,
      "privacy_ok_for_private_memory": true,
      "reasoning_suppression": true
    },
    {
      "name": "llm_master",
      "billing": "local",
      "base_url": "http://LLM_MASTER_HOST:7860/v1",
      "model": "local",
      "auth_env": "KAMIMUSUHI_NODE_TOKEN",
      "peer_local_only": true,
      "timeout_secs": 120,
      "probe_interval_secs": 15,
      "privacy_ok_for_private_memory": true,
      "reasoning_suppression": true,
      "context_limit_tokens": 65536,
      "prefer_lanes": ["FAST_CHAT"]
    }
  ],
  "routing": {
    "small_request_chars": 1200,
    "log_conversations": true,
    "fast_chat_latency_ceiling_ms": 12000,
    "private_by_default": true,
    "max_completion_tokens_for_cost": 768,
    "max_request_cost_usd": 0.02,
    "max_session_cost_usd": 0.5,
    "max_daily_cost_usd": 0.1,
    "max_monthly_cost_usd": 2
  },
  "hai_account": {
    "base_url": "https://hai-api.hcloud.ltd/api",
    "auth_env": "HAI_API_KEY",
    "interval_secs": 900,
    "low_balance_jpy": 0
  },
  "kcore": {
    "binary": "/srv/kamimusuhi/runtime/bin/k-core",
    "dir": "/srv/kamimusuhi/runtime/individual",
    "interval_ms": 60000
  },
  "snapshot": {
    "database": "/srv/kamimusuhi/runtime/individual/kamimusuhi.sqlite",
    "interval_secs": 3600,
    "spool_keep": 3
  },
  "dialogue": {
    "runtime_binary": "/srv/kamimusuhi/runtime/bin/kamimusuhi-runtime",
    "dir": "/srv/kamimusuhi/runtime/individual",
    "privacy": "unconstrained",
    "timeout_secs": 600,
    "max_concurrent": 2
  },
  "mcp_servers": [
    {
      "name": "nas",
      "command": "/srv/kamimusuhi/mcp/node_modules/.bin/mcp-server-filesystem",
      "args": [
        "/mnt/kamimusuhi"
      ],
      "read_only": true,
      "description": "NAS /mnt/kamimusuhi 全体の読み取り（memory, conversations, logs, knowledge など）"
    },
    {
      "name": "fs",
      "command": "/srv/kamimusuhi/mcp/node_modules/.bin/mcp-server-filesystem",
      "args": [
        "/mnt/kamimusuhi/workspace",
        "/mnt/kamimusuhi/artifacts",
        "/mnt/kamimusuhi/experiments",
        "/mnt/kamimusuhi/datasets"
      ],
      "description": "NAS の作業領域（workspace/artifacts/experiments/datasets）の読み書き。ログ・記憶・snapshot は対象外"
    },
    {
      "name": "context7",
      "command": "/srv/kamimusuhi/mcp/node_modules/.bin/context7-mcp",
      "description": "ライブラリ・フレームワークの最新ドキュメント検索（Context7, 外部サービス）"
    },
    {
      "name": "obsidian",
      "command": "/srv/kamimusuhi/mcp/node_modules/.bin/mcpvault",
      "args": [
        "/mnt/kamimusuhi/knowledge/obsidian"
      ],
      "allow": [
        "read_note",
        "read_multiple_notes",
        "read_note_lines",
        "list_directory",
        "search_notes",
        "get_notes_info",
        "get_frontmatter",
        "get_note_outline",
        "get_vault_stats",
        "list_all_tags",
        "write_note",
        "patch_note",
        "update_frontmatter"
      ],
      "description": "操作者の Obsidian vault（private Git リポジトリから Pi が定期 pull する NAS 上の clone）。読み取りは自由、書き換えは操作者の承認後に実行し commit/push",
      "approval_required": [
        "write_note",
        "patch_note",
        "update_frontmatter"
      ],
      "after_approved": [
        "/srv/kamimusuhi/runtime/bin/obsidian-git.sh",
        "commit",
        "kamimusuhi: {tool} (approval {id})"
      ]
    },
    {
      "name": "netdata",
      "command": "/usr/sbin/nd-mcp",
      "args": [
        "ws://127.0.0.1:19999/mcp"
      ],
      "env": {
        "ND_MCP_BEARER_TOKEN": "$NETDATA_MCP_KEY"
      },
      "description": "Pi の Netdata（メトリクス・アラート・異常検知, 読み取り専用）"
    },
    {
      "name": "github",
      "command": "/srv/kamimusuhi/mcp/github/github-mcp-server",
      "args": [
        "stdio",
        "--read-only",
        "--lockdown-mode",
        "--toolsets=context,repos,issues,pull_requests,actions"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
      },
      "read_only": true,
      "description": "GitHubの読み取り専用参照。書き込み系 tool は出さない"
    },
    {
      "name": "chrome_web",
      "command": "/srv/kamimusuhi/mcp/chrome-web/bin/chrome-web-mcp",
      "allow": [
        "google_search",
        "fetch_url",
        "health_check"
      ],
      "call_timeout_secs": 25,
      "description": "公開Webの検索と本文取得。Googleはこの環境でCAPTCHAを確認したため、公開情報の調べ物にはfetch_urlでhttps://www.bing.com/search?q=<検索語をURLエンコード>をformat=markdown,char_limit=4000で取得する。検索ページのAI要約は根拠にせず、本文またはfollow_up_linksの公式候補URLをfetch_url(format=markdown,char_limit=6000)で開き、確認した出典URLを添える。GoogleのCAPTCHAを繰り返し再試行しない。非公開資料・会話履歴・認証情報を検索語に含めない。"
    }
  ],
  "jobs": [
    {
      "name": "obsidian-pull",
      "command": "/srv/kamimusuhi/runtime/bin/obsidian-git.sh",
      "args": [
        "pull"
      ],
      "interval_secs": 900,
      "timeout_secs": 600,
      "run_at_start": true
    }
  ]
}
