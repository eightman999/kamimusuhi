# Copy to /srv/kamimusuhi/config/discord.env (mode 600), never commit real values.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated operator IDs. All three allowlists are required.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
# Optional: the operator's subject on other surfaces (the desktop uses $USER).
# Set it so Discord shares the same relationship memory and recall as the
# desktop; requires exactly one allowed user. Empty = a Discord-only subject.
DISCORD_OPERATOR_SUBJECT=
# Task notices: when a task needs the operator's decision (a promise the
# individual made without starting a task, an approval) or delegated work
# ends, the bot posts in this channel mentioning this user. Both default to
# the only allowed user / channel; set them when several are allowed.
# DISCORD_NOTIFY=off disables the notices.
DISCORD_NOTIFY=on
DISCORD_NOTIFY_USER_ID=
DISCORD_NOTIFY_CHANNEL_ID=
