[Unit]
Description=Slack Socket Mode gateway for Kamimusuhi
Wants=network-online.target kamimusuhi-resident.service
After=network-online.target kamimusuhi-resident.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=eightman
Group=eightman
EnvironmentFile=/srv/kamimusuhi/config/slack.env
ExecStart=/srv/kamimusuhi/runtime/bin/kamimusuhi-slack
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
